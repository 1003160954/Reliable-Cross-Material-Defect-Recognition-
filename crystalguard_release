def make_summary_figures(args):
    import matplotlib.pyplot as plt
    import seaborn as sns

    out = Path(args.output)
    out.mkdir(parents=True, exist_ok=True)

    sns.set_theme(style="whitegrid", font_scale=1.1)

    forward = pd.DataFrame({
        "split": ["source_test_CdTe", "target_test_SrTiO3", "target_all_SrTiO3"],
        "balanced_acc_mean": [0.991954, 0.932817, 0.940686],
        "balanced_acc_std": [0.005267, 0.015889, 0.016241],
        "auc_mean": [1.000000, 0.989788, 0.984706],
        "auc_std": [0.000000, 0.006731, 0.005541],
    })

    fig, ax = plt.subplots(figsize=(7.2, 4.0))
    colors = ["#7895CB", "#D95F5F", "#8AB17D"]
    ax.bar(
        forward["split"],
        forward["balanced_acc_mean"],
        yerr=forward["balanced_acc_std"],
        capsize=4,
        color=colors,
    )
    ax.axhline(0.5, color="0.35", ls="--", lw=1)
    ax.set_ylim(0.45, 1.02)
    ax.set_ylabel("Balanced accuracy")
    ax.set_title("Reliable dual-domain EMA: CdTe to SrTiO3")
    ax.tick_params(axis="x", rotation=15)

