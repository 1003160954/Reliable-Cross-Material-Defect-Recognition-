def build_parser():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--task",
        choices=["forward", "reverse_fewshot", "figures"],
        required=True,
    )

    parser.add_argument("--manifest", default=None)
    parser.add_argument("--output", required=True)

    parser.add_argument("--seed", type=int, default=20260901)
    parser.add_argument("--image-size", type=int, default=224)
    parser.add_argument("--batch-size", type=int, default=32)

    parser.add_argument("--input-mode", default="full", choices=["real", "real_fft", "real_residual", "full"])
    parser.add_argument("--width", type=int, default=32)

    parser.add_argument("--warmup-epochs", type=int, default=10)
    parser.add_argument("--adapt-epochs", type=int, default=25)

    parser.add_argument("--lr", type=float, default=2e-4)
    parser.add_argument("--weight-decay", type=float, default=1e-4)

    parser.add_argument("--lambda-pseudo", type=float, default=0.6)
    parser.add_argument("--lambda-cons", type=float, default=0.15)
    parser.add_argument("--lambda-prior", type=float, default=0.10)
    parser.add_argument("--conf-threshold", type=float, default=0.90)
    parser.add_argument("--target-prior", type=float, default=None)

    parser.add_argument("--k-values", default="1,2,3,5,10")
    parser.add_argument(
        "--seeds",
        default="20260901,20260902,20260903,20260904,20260905,"
                "20260906,20260907,20260908,20260909,20260910,"
                "20260911,20260912,20260913,20260914,20260915,"
                "20260916,20260917,20260918,20260919,20260920"
    )

    return parser


def main():
    args = build_parser().parse_args()

    if args.task in ["forward", "reverse_fewshot"]:
        assert args.manifest is not None, "--manifest is required"

    if args.task == "forward":
        run_forward_cdte_to_sto(args)
    elif args.task == "reverse_fewshot":
        run_reverse_fewshot(args)
    elif args.task == "figures":
        make_summary_figures(args)


if __name__ == "__main__":
    main()
